# ============================================================
# PHD PROFESSOR REVIEW & COLD OUTREACH CRM - ENVIRONMENT TEMPLATE
# Copy this file to .env and insert your real credentials.
# ============================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
SECRET_KEY=your_random_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Authorized Gemini Multi-Key Pool (From Google AI Studio)
GEMINI_API_KEY_01=your_gemini_api_key_01
GEMINI_API_KEY_02=your_gemini_api_key_02
GEMINI_API_KEY_03=your_gemini_api_key_03
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter API Key (optional fallback)
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional SMTP Settings (or configure via CRM Settings UI)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Your Name"
